/* Premium Glassmorphism Dark Theme Overhaul */

* {
    font-family: "Segoe UI Variable Display", "Segoe UI", "Inter", "Roboto", sans-serif;
    font-size: 10pt;
}

/* Global Typography & Default Widget styling */
QWidget {
    color: #f8fafc;
}

QMainWindow {
    background: transparent;
}

/* Stunning Main Background Gradient */
#mainCentralWidget {
    background: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 1,
        stop: 0 rgba(15, 23, 42, 0.5),      /* Deep slate */
        stop: 0.5 rgba(30, 27, 75, 0.5),    /* Rich indigo/purple */
        stop: 1 rgba(2, 6, 23, 0.5)         /* Almost black */
    );
    border-radius: 8px;
}

/* Glass Panels: TreeView, GridView, Address Bar, Menus */
QTreeView, QListView, QStackedWidget > QFrame, QMenu {
    background-color: rgba(15, 23, 42, 0.4); /* Translucent */
    border: 1px solid rgba(255, 255, 255, 0.08);
    border-top: 1px solid rgba(255, 255, 255, 0.15); /* Top highlight for 3D effect */
    border-radius: 12px;
    padding: 4px;
}

/* Focus and Outline handling */
QTreeView:focus, QListView:focus {
    border: 1px solid rgba(99, 102, 241, 0.5); /* Soft indigo glow */
    outline: none;
}

/* Input Fields (Search, AI Command, Address Bar) */
QLineEdit {
    background-color: rgba(30, 41, 59, 0.6);
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 8px;
    padding: 6px 14px;
    color: #ffffff;
    selection-background-color: #6366f1; /* Indigo selection */
}
QLineEdit:focus {
    border: 1px solid rgba(99, 102, 241, 0.8);
    background-color: rgba(15, 23, 42, 0.8);
}
QLineEdit::placeholder {
    color: rgba(255, 255, 255, 0.35);
}

/* Command Bar / ToolBar */
QToolBar {
    border: none;
    border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    background-color: transparent; /* Let the central gradient bleed through */
    padding: 8px;
    spacing: 12px;
}

/* Elegant Tool Buttons */
QToolButton {
    background-color: transparent;
    border: 1px solid transparent;
    padding: 8px 12px;
    border-radius: 8px;
    color: #e2e8f0;
    font-weight: 500;
}
QToolButton:hover {
    background-color: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(255, 255, 255, 0.15);
}
QToolButton:pressed {
    background-color: rgba(255, 255, 255, 0.05);
    border: 1px solid rgba(255, 255, 255, 0.05);
}

/* View Items (Tree/List) */
QTreeView::item, QListView::item {
    padding: 8px;
    border-radius: 6px;
    margin: 2px 4px;
    border: 1px solid transparent;
}
QTreeView::item:hover, QListView::item:hover {
    background-color: rgba(255, 255, 255, 0.08);
    border: 1px solid rgba(255, 255, 255, 0.05);
}
/* Premium Gradient Selection State */
QTreeView::item:selected, QListView::item:selected {
    background-color: qlineargradient(
        x1: 0, y1: 0, x2: 1, y2: 0,
        stop: 0 rgba(79, 70, 229, 0.7),  /* Indigo */
        stop: 1 rgba(147, 51, 234, 0.7)  /* Purple */
    );
    border: 1px solid rgba(255, 255, 255, 0.2);
    color: #ffffff;
}

/* Context Menus */
QMenu {
    background-color: rgba(15, 23, 42, 0.9);
    border: 1px solid rgba(255, 255, 255, 0.12);
    border-radius: 10px;
    padding: 6px;
}
QMenu::item {
    padding: 6px 28px 6px 16px;
    border-radius: 6px;
    margin: 2px 0px;
}
QMenu::item:selected {
    background-color: rgba(79, 70, 229, 0.7); /* Indigo highlight */
}
QMenu::separator {
    height: 1px;
    background: rgba(255, 255, 255, 0.1);
    margin: 6px 14px;
}

/* Sleek Scrollbars */
QScrollBar:vertical {
    border: none;
    background: transparent;
    width: 10px;
    margin: 0px;
}
QScrollBar::handle:vertical {
    background: rgba(255, 255, 255, 0.15);
    min-height: 40px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:vertical:hover {
    background: rgba(255, 255, 255, 0.3);
}
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical,
QScrollBar::add-page:vertical, QScrollBar::sub-page:vertical {
    border: none; background: none;
}

QScrollBar:horizontal {
    border: none;
    background: transparent;
    height: 10px;
    margin: 0px;
}
QScrollBar::handle:horizontal {
    background: rgba(255, 255, 255, 0.15);
    min-width: 40px;
    border-radius: 5px;
    margin: 2px;
}
QScrollBar::handle:horizontal:hover {
    background: rgba(255, 255, 255, 0.3);
}
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal,
QScrollBar::add-page:horizontal, QScrollBar::sub-page:horizontal {
    border: none; background: none;
}

/* Splitter Handle */
QSplitter::handle {
    background: transparent;
    width: 6px;
}
QSplitter::handle:hover {
    background: rgba(99, 102, 241, 0.4);
}

QStatusBar {
    background: transparent;
    border: none;
    color: rgba(255, 255, 255, 0.5);
}
